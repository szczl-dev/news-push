# ============================================================
# 美国新闻每日推送 · 环境配置
# 复制此文件为 .env 并填入真实的 API Key
# ============================================================

# [必填] DeepSeek API Key (或其他 Anthropic 兼容的 API Key)
ANTHROPIC_API_KEY=sk-your-api-key-here

# [可选] API 地址 & 模型
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_MODEL=deepseek-chat

# [可选] 飞书 Webhook 地址
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# [可选] HTTP 代理（用于访问被墙的 RSS 源如 Bloomberg/NYT）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# [可选] 时间窗口：前一天几点 → 当天几点（北京时间）
# NEWS_WINDOW_START_HOUR=12
# NEWS_WINDOW_END_HOUR=6

# [可选] 最多发送给 LLM 的文章数
# MAX_ARTICLES_FOR_LLM=150
